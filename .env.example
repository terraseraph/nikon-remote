# Copy to .env (next to package.json, or in the desktop app's data folder) and fill in what you use.
# Everything is optional: without keys the camera remote works fully, only the AI features are off.
# The API keys below can also be added in the app under More › AI (saved to settings.json in the
# same folder); a key saved there is used instead of the one here.

# --- Shot assist (AI exposure suggestions). Any one of these enables it. ---
NOUS_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Which model the picker starts on, e.g. nous:anthropic/claude-haiku-5.5 or anthropic/claude-haiku-5.5
# ADVISOR_MODEL=
# Comma-separated model ids to offer instead of the built-in lists
# ADVISOR_MODELS=
# NOUS_MODELS=
# NOUS_BASE_URL=

# --- Inspo (reference photo search). Any one of these enables it. ---
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
SERPER_API_KEY=
# Model that turns your request into search queries (defaults to Claude Haiku 5.5)
# INSPO_MODEL=
# on = filter explicit Google Images results
# INSPO_SAFESEARCH=

# --- Server ---
# PORT=8765
# 0 = only reachable from this computer (no phone access)
# LAN=
# Where photos are saved (default: Pictures/Nikon Remote)
# CAPTURES_DIR=

# --- Cloudflare Tunnel (remote access from anywhere) ---
# CF_TUNNEL=
# CF_TUNNEL_URL=
# CLOUDFLARED=
